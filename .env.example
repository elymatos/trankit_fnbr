# SQLAlchemy MariaDB URL. Use a database account restricted to SELECT.
FNBR_DATABASE_URL=mysql+pymysql://readonly:password@database:3306/webtool45_db
# Immutable snapshot ID in training; identifiable deployment revision at runtime.
FNBR_LEXICON_REVISION=webtool45-YYYYMMDD

TRANKIT_CACHE_DIR=./cache/trankit
TRANKIT_EMBEDDING=xlm-roberta-large
TRANKIT_GPU=false

# Customized Trankit checkpoint containing the lemma_type head.
FNBR_TRANKIT_LANGUAGE=customized
FNBR_TRANKIT_CACHE_DIR=./cache/fnbr
FNBR_MODEL_VERSION=unversioned

FNBR_DB_POOL_SIZE=5
FNBR_DB_POOL_RECYCLE_SECONDS=1800
FNBR_DB_CONNECT_TIMEOUT=10
FNBR_DB_QUERY_TIMEOUT=30
