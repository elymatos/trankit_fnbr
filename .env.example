# SQLAlchemy MariaDB URL. Use a database account restricted to SELECT.
FNBR_DATABASE_URL=mysql+pymysql://readonly:password@database:3306/webtool46_db
# Immutable snapshot ID in training; identifiable deployment revision at runtime.
FNBR_LEXICON_REVISION=webtool46-YYYYMMDD

TRANKIT_CACHE_DIR=./cache/trankit
TRANKIT_EMBEDDING=xlm-roberta-large
TRANKIT_GPU=false

# Model mode uses the joint checkpoint in the mounted cache; use lexical/projected
# for the dictionary-derived baseline, or fnbr/projected for the type-only model.
FNBR_PREDICTOR_MODE=model
FNBR_SCAFFOLD_SOURCE=model
FNBR_TRANKIT_LANGUAGE=customized
FNBR_TRANKIT_CACHE_DIR=./cache/fnbr-joint
FNBR_MODEL_VERSION=h8418_0-joint-epoch3@202610021100

# Compose binds HTTP to localhost unless an authenticated reverse proxy is used.
FNBR_HTTP_BIND=127.0.0.1
FNBR_HTTP_PORT=8405

FNBR_DB_POOL_SIZE=5
FNBR_DB_POOL_RECYCLE_SECONDS=1800
FNBR_DB_CONNECT_TIMEOUT=10
FNBR_DB_QUERY_TIMEOUT=30
